{
  "name": "open-dictionary",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-data": "node scripts/fetch-data.ts",
    "build-data": "node --max-old-space-size=8000 scripts/build-data.ts",
    "dev": "react-router dev",
    "build": "react-router build && node scripts/postbuild.ts",
    "preview": "wrangler dev --port 4173",
    "typecheck": "react-router typegen && tsc",
    "deploy": "wrangler deploy",
    "check:design": "tinyrack-ui-check",
    "test": "node --test app/lib/*.test.ts"
  },
  "dependencies": {
    "@tinyrack/ui": "0.35.1",
    "isbot": "^5",
    "lucide-react": "1.59.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "wrangler": "^4.160.0"
  },
  "packageManager": "pnpm@12.18.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  }
}

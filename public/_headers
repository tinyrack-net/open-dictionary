/assets/*
  Cache-Control: public, max-age=31536000, immutable

# /data/<version>/* never changes: a new data build gets a new version (app/lib/dataVersion.ts)
/data/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/data/version.txt
  ! Cache-Control
  Cache-Control: no-cache

# The service worker must be revalidated so a deploy reaches installed apps (scripts/sw.template.js)
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
